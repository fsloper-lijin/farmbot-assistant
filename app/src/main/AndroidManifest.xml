<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 菜到点需要精确提醒（AlarmManager.setExact），否则提醒会被系统合并/延迟 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- 到点用全屏通知把界面顶上来（锁屏时也能亮屏提醒） -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- 到点唤醒屏幕，让提醒在锁屏上可见 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 系统时钟的 HandleSetAlarmActivity 声明了这个普通权限，不申请会被 Permission Denial 拒掉 -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- Android 11+ 包可见性：不声明就解析不到系统时钟，SET_ALARM 会抛 ActivityNotFoundException -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SHOW_ALARMS" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/ic_menu_manage"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FarmBot">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".alarm.AlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.farmbot.assistant.ALARM_TEST" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".CmdReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.farmbot.assistant.CMD_CAPTURE" />
                <action android:name="com.farmbot.assistant.CMD_GRID" />
                <action android:name="com.farmbot.assistant.CMD_TAP" />
                <action android:name="com.farmbot.assistant.CMD_SWIPE" />
                <action android:name="com.farmbot.assistant.CMD_BACK" />
                <action android:name="com.farmbot.assistant.CMD_PING" />
                <action android:name="com.farmbot.assistant.CMD_SCAN" />
            </intent-filter>
        </receiver>

        <service
            android:name=".bot.BotService"
            android:exported="true"
            android:label="@string/service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- 快捷开关磁贴：让 SystemUI 持有本应用组件，降低无障碍被系统回收的概率 -->
        <service
            android:name=".bot.KeepAliveTile"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>

    </application>

</manifest>
